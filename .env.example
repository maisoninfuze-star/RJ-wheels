# Copy to Vercel → Project → Settings → Environment Variables (never commit real values).
ANTHROPIC_API_KEY=           # Claude API key (console.anthropic.com) — powers the website assistant
SMTP_PASS=                   # password of the info@rjwheels.ca Spacemail mailbox — sends booking/quote emails
# SMTP_USER=info@rjwheels.ca          # optional: mailbox login (default info@rjwheels.ca)
# SMTP_HOST=mail.spacemail.com        # optional overrides
# SMTP_PORT=465
# Recipient is fixed in code: info@rjwheels.ca (src/content.mjs → business.email).
# ALLOWED_ORIGINS=https://rjwheels.ca,https://www.rjwheels.ca   # optional extra allowed origins
