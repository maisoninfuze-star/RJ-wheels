# Copy to Vercel → Project → Settings → Environment Variables (never commit real values).
ANTHROPIC_API_KEY=           # Claude API key (console.anthropic.com) — powers the website assistant
RESEND_API_KEY=              # Resend API key (resend.com) — sends booking/quote emails
MAIL_FROM="RJ Welding & Wheels <reservations@rjwheels.ca>"   # a sender on a domain verified in Resend
MAIL_TO=info@rjwheels.ca     # where requests are delivered (default info@rjwheels.ca)
# ALLOWED_ORIGINS=https://rjwheels.ca,https://www.rjwheels.ca   # optional extra allowed origins
